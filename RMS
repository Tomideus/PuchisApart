// ==========================================
// WEB APP: RESUMEN DE PRECIO
// ==========================================
function obtenerResumenPrecio(checkIn, checkOut, propiedad, nHuespedes) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hojaCal = ss.getSheetByName(CONFIG.hojas.calendario);
  const hojaConfig = ss.getSheetByName(CONFIG.hojas.configuracion);
  if (!hojaCal) return { error: "No se encontró el Calendario Maestro" };
  
  const calData = hojaCal.getDataRange().getValues();
  const configData = hojaConfig ? hojaConfig.getDataRange().getValues() : [];
  
  let tipoCambio = 1400, comision = 0.18;
  for (let i = 1; i < configData.length; i++) {
    const param = String(configData[i][0] || "").toLowerCase();
    if (param.includes("tipo de cambio")) tipoCambio = Number(configData[i][1]) || tipoCambio;
    if (param.includes("comisión") || param.includes("comision")) comision = Number(configData[i][1]) || comision;
  }
  
  const fechaIn = new Date(checkIn); fechaIn.setMinutes(fechaIn.getMinutes() + fechaIn.getTimezoneOffset()); fechaIn.setHours(0,0,0,0);
  const fechaOut = new Date(checkOut); fechaOut.setMinutes(fechaOut.getMinutes() + fechaOut.getTimezoneOffset()); fechaOut.setHours(0,0,0,0);
  if (fechaOut <= fechaIn) return { error: "Check-out debe ser posterior a check-in" };
  
  const noches = Math.ceil((fechaOut - fechaIn) / (1000 * 60 * 60 * 24));
  
  const tasasExtra = { "Obispo Trejo": 7000, "Independencia": 8000, "Estrada": 10000 };
  const cantidadExtra = nHuespedes > 2 ? nHuespedes - 2 : 0;
  const tarifaExtraNoche = cantidadExtra * (tasasExtra[propiedad] || 0);
  
  let totalBrutoARS = 0, preciosDiarios = [], diasSinPrecio = [];
  
  for (let d = 0; d < noches; d++) {
    const fechaDia = new Date(fechaIn); fechaDia.setDate(fechaIn.getDate() + d);
    const fechaDiaStr = fechaDia.toDateString();
    let precioDia = null;
    for (let i = 1; i < calData.length; i++) {
      const filaFecha = new Date(calData[i][0]); if (isNaN(filaFecha)) continue;
      if (filaFecha.toDateString() === fechaDiaStr && String(calData[i][1] || "").trim() === propiedad) {
        precioDia = Number(calData[i][5]) || 0; break;
      }
    }
    if (precioDia && precioDia > 0) {
      const precioFinalDia = precioDia + tarifaExtraNoche;
      totalBrutoARS += precioFinalDia;
      let detalleDia = `${fechaDia.toLocaleDateString('es-AR', { weekday: 'short', day: 'numeric', month: 'short' })}`;
      if (cantidadExtra > 0) detalleDia += ` (+${cantidadExtra} huesp. x $${Math.round(tarifaExtraNoche/cantidadExtra).toLocaleString('es-AR')})`;
      preciosDiarios.push({ fecha: fechaDia.toISOString().split('T')[0], dia: detalleDia, precio: precioFinalDia });
    } else { diasSinPrecio.push(fechaDiaStr); }
  }
  
  const totalNetoBase = totalBrutoARS * (1 - comision);
  const factorEstancia = obtenerFactorEstancia(noches);
  const descuentoLabel = obtenerDescuentoEstanciaLabel(noches);
  const pisoNeto = obtenerPisoNetoPorPropiedad(propiedad, configData);
  let totalNetoConDescuento = totalNetoBase * factorEstancia;
  
  const promedioNeto = totalNetoConDescuento / noches;
  let pisoAplicado = false;
  if (promedioNeto < pisoNeto) {
    totalNetoConDescuento = pisoNeto * noches;
    pisoAplicado = true;
  }
  
  return {
    success: true, propiedad: propiedad, 
    checkIn: fechaIn.toISOString().split('T')[0], 
    checkOut: fechaOut.toISOString().split('T')[0],
    noches: noches, 
    totalBrutoARS: Math.round(totalBrutoARS),
    totalNetoBase: Math.round(totalNetoBase),
    totalNetoConDescuento: Math.round(totalNetoConDescuento),
    factorEstancia: factorEstancia,
    descuentoLabel: descuentoLabel,
    pisoAplicado: pisoAplicado,
    pisoNeto: pisoNeto,
    tipoCambio: tipoCambio, comision: comision, 
    preciosDiarios: preciosDiarios, 
    diasSinPrecio: diasSinPrecio, 
    disponible: diasSinPrecio.length === 0,
    cantidadExtra: cantidadExtra, 
    tarifaExtraNoche: tarifaExtraNoche
  };
}

// ==========================================
// WEB APP: CONFIRMAR RESERVA
// ==========================================
function confirmarReserva(checkIn, checkOut, propiedad, huesped, nHuespedes, extra, reintegro, notas, plataforma, precioNetoManual) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hojaCal = ss.getSheetByName(CONFIG.hojas.calendario);
  const hojaReservas = ss.getSheetByName(CONFIG.hojas.reservas);
  if (!hojaCal || !hojaReservas) return { success: false, error: "Hojas no encontradas" };
  
  const calData = hojaCal.getDataRange().getValues();
  const configData = ss.getSheetByName(CONFIG.hojas.configuracion)?.getDataRange().getValues() || [];
  
  let tipoCambio = 1400, comision = 0.18;
  for (let i = 1; i < configData.length; i++) {
    const param = String(configData[i][0] || "").toLowerCase();
    if (param.includes("tipo de cambio")) tipoCambio = Number(configData[i][1]) || tipoCambio;
    if (param.includes("comisión") || param.includes("comision")) comision = Number(configData[i][1]) || comision;
  }
  
  let totalNetoBase = 0;
  if (precioNetoManual && precioNetoManual > 0) {
    totalNetoBase = Number(precioNetoManual);
  } else {
    const resumen = obtenerResumenPrecio(checkIn, checkOut, propiedad, nHuespedes);
    if (resumen.error) return { success: false, error: resumen.error };
    totalNetoBase = resumen.totalNetoConDescuento;
  }
  
  const extraVal = Number(extra) || 0; 
  const reintegroVal = Number(reintegro) || 0;
  const totalNetoFinal = totalNetoBase + extraVal - reintegroVal;
  
  let precioCobrar = totalNetoFinal;
  if (plataforma === "Booking") {
    precioCobrar = Math.round(totalNetoFinal / (1 - comision));
  }
  
  let filasModificadas = 0;
  const fechaIn = new Date(checkIn); fechaIn.setMinutes(fechaIn.getMinutes() + fechaIn.getTimezoneOffset());
  const fechaOut = new Date(checkOut); fechaOut.setMinutes(fechaOut.getMinutes() + fechaOut.getTimezoneOffset());
  const noches = Math.ceil((fechaOut - fechaIn) / (1000 * 60 * 60 * 24));
  
  for (let d = 0; d < noches; d++) {
    const fechaDia = new Date(fechaIn); fechaDia.setDate(fechaIn.getDate() + d);
    const fechaDiaStr = fechaDia.toDateString();
    for (let i = 1; i < calData.length; i++) {
      const filaFecha = new Date(calData[i][0]); if (isNaN(filaFecha)) continue;
      if (filaFecha.toDateString() === fechaDiaStr && String(calData[i][1] || "").trim() === propiedad) {
        hojaCal.getRange(i + 1, 4).setValue("Reservado"); 
        filasModificadas++; 
        break;
      }
    }
  }
  if (filasModificadas === 0) return { success: false, error: "Fechas no encontradas" };
  
  const idReserva = "R" + new Date().getTime().toString().slice(-6);
  
  hojaReservas.appendRow([
    new Date(), idReserva, propiedad, checkIn, checkOut, noches, 
    huesped, nHuespedes, Math.round(precioCobrar), 
    extraVal, reintegroVal, Math.round(totalNetoFinal), 
    (totalNetoFinal/tipoCambio).toFixed(2), notas || "", plataforma
  ]);
  
  return { 
    success: true, idReserva: idReserva, noches: noches, 
    totalNeto: Math.round(totalNetoFinal), 
    precioCobrar: Math.round(precioCobrar), 
    plataforma: plataforma 
  };
  
}
