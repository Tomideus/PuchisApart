function crearActivadorAutomatico() {
  const triggers = ScriptApp.getProjectTriggers();
  for (let i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'calcularPreciosAhora') {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
  ScriptApp.newTrigger('calcularPreciosAhora').timeBased().everyHours(2).create();
  Logger.log('✅ Activador creado: cada 2 horas');
}

function desactivarCalculoAutomatico() {
  const triggers = ScriptApp.getProjectTriggers();
  for (let i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'calcularPreciosAhora') {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
  Logger.log('❌ Activador eliminado');
}

