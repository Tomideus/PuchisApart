// ==========================================
// CONFIGURACIÓN GLOBAL
// ==========================================
const CONFIG = {
  pisosDefault: 55000,
  hojas: {
    calendario: "01 - Calendario Maestro",
    mercado: "06 - Mercado Booking",
    eventos: "04 - Eventos Especiales",
    configuracion: "00 - Configuración",
    reglas: "02 - Reglas de Pricing",
    reservas: "08 - Reservas"
  }
};

// ==========================================
// HELPER: COMISIÓN
// ==========================================
function obtenerComision(configData) {
  if (!configData || configData.length < 2) return 0.18;
  for (let i = 1; i < configData.length; i++) {
    const param = String(configData[i][0] || "").toLowerCase();
    if (param.includes("comisión") || param.includes("comision")) {
      return Number(configData[i][1]) || 0.18;
    }
  }
  return 0.18;
}

// ==========================================
// CAPA 1: PRECIO BASE
// (recibe fecha YA corregida de timezone)
// ==========================================
function obtenerPrecioBase(fecha, propiedad, reglasData, comision) {
  if (!reglasData || reglasData.length < 2) return Math.ceil((60000 / (1 - comision)) / 500) * 500;
  
  const mes = fecha.getMonth();
  let temporada = "Media";
  if (mes >= 0 && mes <= 2) temporada = "Alta";
  if (mes === 6) temporada = "Alta";
  if (mes === 11) temporada = "Baja";
  
  const diaSemana = fecha.getDay();
  const esFinde = (diaSemana === 5 || diaSemana === 6);
  const tipoDiaBuscado = esFinde ? "Finde" : "Entre Semana";  // ← CORREGIDO: S mayúscula
  
  for (let i = 1; i < reglasData.length; i++) {
    const temporadaRegla = String(reglasData[i][0] || "").trim();
    const tipoDiaRegla = String(reglasData[i][1] || "").trim();
    const propiedadRegla = String(reglasData[i][2] || "").trim();
    
    if (temporadaRegla === temporada && 
        tipoDiaRegla === tipoDiaBuscado &&
        (propiedadRegla === propiedad || propiedadRegla === "Todas")) {
      const precioNeto = Number(reglasData[i][3]) || 60000;
      return Math.ceil((precioNeto / (1 - comision)) / 500) * 500;
    }
  }
  return Math.ceil((60000 / (1 - comision)) / 500) * 500;
}

function obtenerPrecioBaseConTipoDia(fecha, propiedad, tipoDiaForzado, reglasData, comision) {
  if (!reglasData || reglasData.length < 2) return Math.ceil((60000 / (1 - comision)) / 500) * 500;
  
  const mes = fecha.getMonth();
  let temporada = "Media";
  if (mes >= 0 && mes <= 2) temporada = "Alta";
  if (mes === 6) temporada = "Alta";
  if (mes === 11) temporada = "Baja";
  
  for (let i = 1; i < reglasData.length; i++) {
    const temporadaRegla = String(reglasData[i][0] || "").trim();
    const tipoDiaRegla = String(reglasData[i][1] || "").trim();
    const propiedadRegla = String(reglasData[i][2] || "").trim();
    
    if (temporadaRegla === temporada && 
        tipoDiaRegla === tipoDiaForzado &&
        (propiedadRegla === propiedad || propiedadRegla === "Todas")) {
      const precioNeto = Number(reglasData[i][3]) || 60000;
      return Math.ceil((precioNeto / (1 - comision)) / 500) * 500;
    }
  }
  return Math.ceil((60000 / (1 - comision)) / 500) * 500;
}

// ==========================================
// CAPA 2: ANTICIPACIÓN
// ==========================================
function obtenerFactorAnticipacion(diasAnt) {
  if (diasAnt > 30) return 0.90;   // -10% (reserva muy anticipada)
  if (diasAnt >= 15) return 0.95;  // -5% (15-30 días)
  if (diasAnt >= 4 && diasAnt <= 7) return 0.95;
  return 1.0;                   
}

// ==========================================
// CAPA 3: EVENTOS (recibe fecha ya corregida)
// ==========================================
function obtenerFactorEventos(fecha, eventosData) {
  if (!eventosData || eventosData.length < 2) return 1.0;
  for (let i = 1; i < eventosData.length; i++) {
    if (!eventosData[i][0]) continue;
    const fechaInicio = new Date(eventosData[i][0]);
    fechaInicio.setHours(0, 0, 0, 0);
    let fechaFin = fechaInicio;
    const celdaFin = eventosData[i][2];
    if (celdaFin && !isNaN(new Date(celdaFin))) {
      fechaFin = new Date(celdaFin);
      fechaFin.setHours(0, 0, 0, 0);
    }
    if (fecha >= fechaInicio && fecha <= fechaFin) {
      return Number(eventosData[i][3]) || 1.0;
    }
  }
  return 1.0;
}

function esFeriado(fecha, eventosData) {
  if (!eventosData || eventosData.length < 2) return false;
  for (let i = 1; i < eventosData.length; i++) {
    if (!eventosData[i][0]) continue;
    const fechaInicio = new Date(eventosData[i][0]);
    fechaInicio.setHours(0, 0, 0, 0);
    let fechaFin = fechaInicio;
    const celdaFin = eventosData[i][2];
    if (celdaFin && !isNaN(new Date(celdaFin))) {
      fechaFin = new Date(celdaFin);
      fechaFin.setHours(0, 0, 0, 0);
    }
    if (fecha >= fechaInicio && fecha <= fechaFin) return true;
  }
  return false;
}

function esSuperDomingo(fecha, eventosData) {
  if (fecha.getDay() !== 0) return false;
  const lunes = new Date(fecha);
  lunes.setDate(lunes.getDate() + 1);
  return esFeriado(lunes, eventosData);
}

// ==========================================
// CAPA 4: PISO DE RENTABILIDAD
// ==========================================
function obtenerPisoNetoPorPropiedad(propiedad, configData) {
  if (!configData || configData.length < 2) return CONFIG.pisosDefault;
  const keyBusqueda = `Piso - ${propiedad}`.toLowerCase();
  let pisoNeto = null;
  for (let i = 1; i < configData.length; i++) {
    const parametro = String(configData[i][0] || "").trim().toLowerCase();
    if (parametro === keyBusqueda || parametro.includes(keyBusqueda)) {
      const valor = Number(configData[i][1]);
      if (!isNaN(valor) && valor > 0) { pisoNeto = valor; break; }
    }
  }
  if (pisoNeto === null) {
    for (let i = 1; i < configData.length; i++) {
      const parametro = String(configData[i][0] || "").trim().toLowerCase();
      if (parametro.includes("piso") && parametro.includes("default")) {
        const valor = Number(configData[i][1]);
        if (!isNaN(valor) && valor > 0) { pisoNeto = valor; break; }
      }
    }
  }
  return pisoNeto || CONFIG.pisosDefault;
}

function obtenerPisoPorPropiedad(propiedad, configData) {
  const comision = obtenerComision(configData);
  const pisoNeto = obtenerPisoNetoPorPropiedad(propiedad, configData);
  return Math.ceil((pisoNeto / (1 - comision)) / 500) * 500;
}

// ==========================================
// HELPER: DESCUENTO POR ESTANCIA
// ==========================================
function obtenerFactorEstancia(noches) {
  if (noches >= 14) return 0.85;
  if (noches >= 7)  return 0.90;
  if (noches >= 3)  return 0.95;
  return 1.0;
}

function obtenerDescuentoEstanciaLabel(noches) {
  if (noches >= 14) return "-15% (14+ noches)";
  if (noches >= 7)  return "-10% (7+ noches)";
  if (noches >= 3)  return "-5% (3+ noches)";
  return null;
}

// ==========================================
// CAPA 5: AJUSTE POR MERCADO (ACTUALIZADO)
// ==========================================
function obtenerFactorMercado(diasAnt, mercadoData) {
  if (!mercadoData || mercadoData.length < 2) return 1.0;
  
  let hoy = null, s3 = null, s7 = null, s30 = null;
  
  // Extraer ocupación de cada ventana
  for (let i = mercadoData.length - 1; i >= 1; i--) {
    const label = String(mercadoData[i][2] || "").trim();
    const ocupStr = String(mercadoData[i][5] || "").trim();
    if (!ocupStr || ocupStr === "N/A") continue;
    
    const ocup = parseFloat(ocupStr.replace('%', ''));
    if (isNaN(ocup)) continue;
    
    if (label === "Hoy" && hoy === null) hoy = ocup;
    if (label === "3 días" && s3 === null) s3 = ocup;
    if (label === "7 días" && s7 === null) s7 = ocup;
    if (label === "30 días" && s30 === null) s30 = ocup;
  }
  
  // Determinar qué ventana usar según días de anticipación
  let ocupacion = null;
  if (diasAnt === 0) ocupacion = hoy;
  else if (diasAnt <= 3) ocupacion = s3;
  else if (diasAnt <= 15) ocupacion = s7;
  else if (diasAnt <= 30) ocupacion = s30;
  
  if (ocupacion === null) return 1.0;
  
  // HOY (0 días)
  if (diasAnt === 0) {
    if (ocupacion <= 75) return 0.85;
    if (ocupacion <= 85) return 0.90;
    if (ocupacion <= 90) return 0.95;
    return 1.05;
  }
  
  // 3 DÍAS (1-3 días)
  if (diasAnt <= 3) {
    if (ocupacion <= 75) return 0.90;
    if (ocupacion <= 85) return 0.95;
    if (ocupacion <= 90) return 1.00;
    return 1.10;
  }
  
  // 7 DÍAS (4-15 días)
  if (diasAnt <= 15) {
    if (ocupacion <= 75) return 0.95;
    if (ocupacion <= 85) return 1.00;
    if (ocupacion <= 90) return 1.05;
    return 1.15;
  }
  
  // 30 DÍAS (16-30 días)
  if (diasAnt <= 30) {
    if (ocupacion <= 75) return 1.00;
    if (ocupacion <= 85) return 1.15;
    if (ocupacion <= 90) return 1.20;
    return 1.25;
  }
  
  // MÁS DE 30 DÍAS: sin ajuste
  return 1.0;
}

// ==========================================
// CAPA 6: HUECOS
// ==========================================
function calcularFactorHueco(fechaStr, propiedad, calData) {
  try {
    const fechaObjStr = new Date(fechaStr).toDateString();
    let idx = -1;
    for (let i = 1; i < calData.length; i++) {
      if (!calData[i][0]) continue;
      const filaFechaStr = new Date(calData[i][0]).toDateString();
      const filaProp = String(calData[i][1] || "").trim();
      if (filaFechaStr === fechaObjStr && filaProp === propiedad) { idx = i; break; }
    }
    if (idx === -1) return 1.0;
    if (String(calData[idx][3] || "").trim() !== "Libre") return 1.0;
    let libresAntes = 0, libresDespues = 0;
    for (let i = idx - 1; i >= 1; i--) {
      if (String(calData[i][3] || "").trim() === "Reservado") break;
      libresAntes++;
    }
    for (let i = idx + 1; i < calData.length; i++) {
      if (String(calData[i][3] || "").trim() === "Reservado") break;
      libresDespues++;
    }
    const huecoTotal = libresAntes + libresDespues + 1;
    if (huecoTotal === 1) return 0.85;
    if (huecoTotal === 2) return 0.90;
    if (huecoTotal === 3) return 0.95;
    return 1.0;
  } catch (e) { return 1.0; }
}

// ==========================================
// DOMINGO NORMAL (-5%)
// ==========================================
function aplicarDescuentoDomingo(precio, fecha) {
  return fecha.getDay() === 0 ? Math.round(precio * 0.95) : precio;
}

// ==========================================
// FUNCIÓN PRINCIPAL DE CÁLCULO
// (único lugar donde se corrige timezone)
// ==========================================
function calcularPrecioFinal(fecha, propiedad, diasAnt, bd) {
  const comision = obtenerComision(bd.config);
  
  // ️ CORRECCIÓN DE TIMEZONE: UNA SOLA VEZ
  const fechaLocal = new Date(fecha);
  fechaLocal.setMinutes(fechaLocal.getMinutes() + fechaLocal.getTimezoneOffset());
  fechaLocal.setHours(0, 0, 0, 0);
  
  const esSuperDom = esSuperDomingo(fechaLocal, bd.eventos);
  const factorEvento = obtenerFactorEventos(fechaLocal, bd.eventos);
  const esFeriadoActual = esFeriado(fechaLocal, bd.eventos);
  
  let precio;
  if (esSuperDom) {
    precio = obtenerPrecioBaseConTipoDia(fechaLocal, propiedad, "Finde", bd.reglas, comision);
  } else {
    precio = obtenerPrecioBase(fechaLocal, propiedad, bd.reglas, comision);
  }
  
  if (esFeriadoActual) {
    const diaSemana = fechaLocal.getDay();
    const esEntreSemana = (diaSemana >= 1 && diaSemana <= 4);
    if (esEntreSemana && !esSuperDom) {
      precio = obtenerPrecioBaseConTipoDia(fechaLocal, propiedad, "Finde", bd.reglas, comision);
    }
    precio *= factorEvento;
  }
  
  if (!esFeriadoActual && !esSuperDom) {
    precio = aplicarDescuentoDomingo(precio, fechaLocal);
    precio *= obtenerFactorAnticipacion(diasAnt);
    precio *= calcularFactorHueco(fecha, propiedad, bd.calendario);
  }
  
  precio *= obtenerFactorMercado(diasAnt, bd.mercado);
  
  const piso = obtenerPisoPorPropiedad(propiedad, bd.config);
  if (precio < piso) precio = piso;
  
  return Math.round(precio);
}

// ==========================================
// EJECUCIÓN MASIVA
// ==========================================
function calcularPreciosAhora() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hojaCal = ss.getSheetByName(CONFIG.hojas.calendario);
  if (!hojaCal || hojaCal.getLastRow() < 2) { Logger.log("❌ No se encontró el Calendario Maestro"); return; }
  
  const bd = {
    calendario: hojaCal.getDataRange().getValues(),
    reglas: ss.getSheetByName(CONFIG.hojas.reglas)?.getDataRange().getValues() || [],
    eventos: ss.getSheetByName(CONFIG.hojas.eventos)?.getDataRange().getValues() || [],
    config: ss.getSheetByName(CONFIG.hojas.configuracion)?.getDataRange().getValues() || [],
    mercado: ss.getSheetByName(CONFIG.hojas.mercado)?.getDataRange().getValues() || []
  };
  
  const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
  const comision = obtenerComision(bd.config);
  let actualizados = 0;
  const preciosBooking = [], preciosNetos = [];
  
  for (let i = 1; i < bd.calendario.length; i++) {
    const fecha = new Date(bd.calendario[i][0]);
    const propiedad = String(bd.calendario[i][1] || "").trim();
    if (!fecha || isNaN(fecha.getTime()) || !propiedad) { 
      preciosBooking.push([bd.calendario[i][5]]);
      preciosNetos.push([bd.calendario[i][6] || ""]);
      continue; 
    }
    const diasAnt = Math.ceil((fecha - hoy) / (1000 * 60 * 60 * 24));
    const precioBooking = calcularPrecioFinal(fecha, propiedad, diasAnt, bd);
    preciosBooking.push([precioBooking]);
    preciosNetos.push([Math.round(precioBooking * (1 - comision))]);
    actualizados++;
  }
  
  if (preciosBooking.length > 0) {
    hojaCal.getRange(2, 6, preciosBooking.length, 1).setValues(preciosBooking);
    hojaCal.getRange(2, 7, preciosNetos.length, 1).setValues(preciosNetos);
  }
  Logger.log(`✅ Precios actualizados: ${actualizados} filas`);
}
