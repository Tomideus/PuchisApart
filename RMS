// ==========================================
// 💵 ACTUALIZAR DÓLAR
// ==========================================
function actualizarDolarOficial() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const hojaConfig = ss.getSheetByName("00 - Configuración");
    if (!hojaConfig) { Logger.log(" No se encontró '00 - Configuración'"); return; }
    
    const response = UrlFetchApp.fetch("https://dolarhoy.com/", {
      muteHttpExceptions: true,
      headers: { "User-Agent": "Mozilla/5.0" }
    });
    
    if (response.getResponseCode() !== 200) return;
    
    const html = response.getContentText();
    let dolarVenta = null;
    
    const match = html.match(/Dólar\s+Oficial[\s\S]*?Venta[\s\S]*?\$?([\d.]+[\d,]+)/i);
    if (match && match[1]) {
      dolarVenta = parseFloat(match[1].replace(/\./g, '').replace(',', '.'));
    }
    
    if (!dolarVenta) {
      const regexMoneda = /\$?\s*([\d.]+[\d,]+)\s*(?:ARS|pesos)?/gi;
      let matchMoneda;
      const valores = [];
      while ((matchMoneda = regexMoneda.exec(html)) !== null) {
        const v = parseFloat(matchMoneda[1].replace(/\./g, '').replace(',', '.'));
        if (v >= 1000 && v <= 3000) valores.push(v);
      }
      if (valores.length > 0) dolarVenta = valores[0];
    }
    
    if (dolarVenta && dolarVenta > 0) {
      hojaConfig.getRange(3, 2).setValue(dolarVenta);
      Logger.log(`✅ Dólar oficial venta actualizado: $${dolarVenta}`);
    }
  } catch (e) {
    Logger.log(`❌ Error actualizando dólar: ${e.message}`);
  }
}

